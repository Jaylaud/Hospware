{
  "name": "@hospware/hub-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format cjs",
    "build:server": "tsup src/server.ts --format cjs",
    "dev": "tsup src/server.ts --format cjs --watch --onSuccess \"node dist/server.js\"",
    "dev:server": "tsup src/server.ts --format cjs --watch --onSuccess \"node dist/server.js\"",
    "start": "node dist/server.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@hospware/core-domain": "*",
    "@hospware/crypto-license": "*",
    "@hospware/database": "*",
    "@hospware/escpos-printer": "*",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@hospware/tsconfig": "*",
    "@tauri-apps/cli": "^2.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
