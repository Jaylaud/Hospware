{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Hospware PMS Hub",
  "version": "1.0.0",
  "identifier": "com.hospware.hub",
  "build": {
    "beforeDevCommand": "npm run dev:server",
    "beforeBuildCommand": "npm run build:server",
    "frontendDist": "http://localhost:4321"
  },
  "app": {
    "windows": [
      {
        "title": "Hospware Hotel PMS - Front Desk Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
