{
  "name": "hospware-pms",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-First Property Management System for Hotels & Property Managers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
